{
  "name": "deskling",
  "private": true,
  "version": "0.1.0",
  "description": "A tiny desktop workshop that shows what your AI agent is actually doing.",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "tauri": "node scripts/with-cargo.mjs tauri",
    "rust:fmt": "node scripts/with-cargo.mjs cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "node scripts/with-cargo.mjs cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "node scripts/with-cargo.mjs cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:check": "npm run rust:fmt && npm run rust:clippy && npm run rust:test",
    "verify:fast": "npm run typecheck && npm run lint && npm run test",
    "verify": "npm run verify:fast && npm run build && npm run rust:check",
    "build:app": "npm run tauri build -- --bundles app"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
